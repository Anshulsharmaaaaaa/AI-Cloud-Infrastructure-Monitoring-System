apiVersion: apps/v1
kind: Deployment
metadata:
  name: ai-monitor-inference
  labels:
    app: ai-monitor
spec:
  replicas: 3
  selector:
    matchLabels:
      app: ai-monitor
  template:
    metadata:
      labels:
        app: ai-monitor
    spec:
      containers:
      - name: inference-container
        image: your-dockerhub-username/ai-monitor-inference:v1.0
        ports:
        - containerPort: 8000
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /docs
            port: 8000
          initialDelaySeconds: 10
          periodSeconds: 5
